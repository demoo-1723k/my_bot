# Get your token from @BotFather on Telegram
BOT_TOKEN=123456789:PUT_YOUR_TOKEN_HERE

# Where mixed quizzes are posted: group chat id or @username
QUIZ_CHAT_ID=-1002292353150

# --- Forum topic ---------------------------------------------------------
# Everything the bot posts (quizzes, notes, answers) goes into this topic.
QUIZ_TOPIC_NAME=Study Room

# Optional: pin the topic's numeric id here so the bot never has to learn it.
# To find it, open the topic and copy the id from the web.telegram.org URL
# (#/?before=12345 ... the number is the last path segment), or simply send
# /topic from inside the topic and the bot remembers it on its own.
# Leave this blank to let the bot learn the id at runtime.
QUIZ_TOPIC_ID=

# --- AI upgrade (optional — bot works without any of these) --------------
# The bot is rule-based by default. Set ONE of these to enable LLM-powered
# quiz / answer / note generation (falls back automatically if unset/fails).

# OpenAI — best quality
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Groq — fast & cheap (OpenAI-compatible)
# GROQ_API_KEY=gsk_...

# Google Gemini — generous free tier
# GEMINI_API_KEY=AIza...
# or GOOGLE_API_KEY=AIza...

# Local Ollama (no API key needed, runs on your machine)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Force a specific provider: auto | openai | gemini | groq | ollama | none
# LLM_PROVIDER=auto
# LLM_MODEL=            # override model name
# LLM_BASE_URL=         # custom base URL (proxy / Ollama host)
# LLM_TIMEOUT=25        # seconds

# --- Dense retrieval (optional, enhances /ask without LLM) -----------------
# pip install sentence-transformers
# Then /ask uses hybrid BM25 + semantic search + reranking automatically.

# --- Who can run the bot -------------------------------------------------
# The group's owner and admins get the full menu (courses, exams, schedules
# and posting) both in the group and in a private chat with the bot.
# Everyone else can only talk to the bot in private: ask questions and get a
# quiz of their own.
